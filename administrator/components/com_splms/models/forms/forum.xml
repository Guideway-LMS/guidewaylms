<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="details">
		<field
			name="id"
			type="hidden"
		/>

		<field
			name="title"
			type="text"
			label="Título"
			description="Título da pergunta"
			class="input-xxlarge input-large-text"
			size="40"
			required="true"
		/>

		<field
			name="body"
			type="editor"
			label="Pergunta"
			description="Detalhes da pergunta"
			class="input-xxlarge"
			filter="safehtml"
			buttons="true"
			height="300"
		/>

		<field
			name="course_id"
			type="sql"
			label="Curso"
			query="SELECT id, title FROM #__splms_courses ORDER BY title"
			key_field="id"
			value_field="title"
			required="true"
		/>

		<field
			name="user_id"
			type="user"
			label="Autor"
			required="true"
		/>

		<field
			name="solved"
			type="list"
			label="Resolvido"
			description="Status da pergunta"
			default="0"
		>
			<option value="0">Não</option>
			<option value="1">Sim</option>
		</field>

		<field
			name="created_on"
			type="calendar"
			label="Criado em"
			format="%Y-%m-%d %H:%M:%S"
			filter="user_utc"
		/>
	</fieldset>
</form>

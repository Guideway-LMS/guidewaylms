<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="basic">
		<field name="id" type="hidden" />
		<field name="title" type="text"
			class="inputbox"
			label="COM_SPLMS_TITLE_TITLE"
			
			required="true"
			size="50"
		 />

		 <field name="alias" type="text"
			class="inputbox"
			label="COM_SPLMS_FIELD_ALIAS"
			description="COM_SPLMS_FIELD_ALIAS_DESC"
			
			size="50"
		 />

		 <field name="image"
 		 	type="media"
 			class="image"
 			label="COM_SPLMS_TITLE_IMAGE"
 			
 		 />

 		<field name="duration"
 			type="number"
 			class="inputbox"
 			label="COM_SPLMS_FIELD_QUIZ_DURATION"
 			description="COM_SPLMS_FIELD_QUIZ_DURATION_DESC"
 			
 			size="50"
 			required="true"
 		/>

        <field 
            name="max_attempts" 
            type="number" 
            label="Limite de Tentativas" 
            description="Defina o número máximo de vezes que o aluno pode realizar este quiz. Deixe 1 para apenas uma tentativa, ou 0 para ilimitado." 
            min="0" 
            default="1" 
        />

 		<field name="course_id"
	     	type="courselist"
	     	default=""
	     	label="COM_SPLMS_LESSON_FIELD_SELECT_COURSE"
	     	description="COM_SPLMS_LESSON_FIELD_SELECT_COURSE_DESC"
	     	topicid="topic_id"
	     	required="true"
     	/>

        <!-- GUIDEWAY CUSTOM: Topic Selection for Auto-Lesson Creation -->
        <field 
            name="topic_id" 
            type="lessontopics" 
            default="" 
            label="COM_SPLMS_LESSON_FIELD_SELECT_TOPIC" 
            description="Selecione o Tópico para criar automaticamente a lição." 
            required="false" 
        />
        
        <field 
            name="passing_score" 
            type="number" 
            label="Nota de Corte da Aula" 
            description="Se deixar em branco, usa o padrão global." 
            min="0" 
            max="100" 
        />

        <field 
            name="is_optional" 
            type="radio" 
            label="Lição Opcional?" 
            class="btn-group btn-group-yesno" 
            default="0"
        >
            <option value="0">JNO</option>
            <option value="1">JYES</option>
        </field>

 		<field name="description" type="editor"
 			class="inputbox span6"
 			label="COM_SPLMS_TITLE_DESCRIPTION"
 			required="true"
 			rows="5"
 			cols="5"
 			filter="JComponentHelper::filterText"
 		/>

 		<field name="quiz_type" type="list" label="COM_SPLMS_FIELD_QUIZ_TYPE"
 			filter="intval" default="1">
 			<option value="0">COM_SPLMS_FREE</option>
 			<option value="1">COM_SPLMS_PAID</option>
 		</field>

 		<field name="list_answers" type="subform"
		formsource="/administrator/components/com_splms/models/fields/quiz_answers.xml" multiple="true"
		label="COM_SPLMS_TITLE_QUIZQUESTIONS" description="" />


	</fieldset>

	<fieldset name="sidebar">
		<field name="published" type="list" label="JSTATUS" class="inputbox" filter="intval" default="1">
 			 <option value="1">JPUBLISHED</option>
 			 <option value="0">JUNPUBLISHED</option>
 	 </field>

	 <field name="created_by" type="user" label="JGLOBAL_FIELD_CREATED_BY_LABEL" />

	 <field name="created" type="calendar"
		label="COM_SPLMS_TITLE_CREATED_DATE"
		translateformat="true"
		default="NOW"
	 />

	 <field name="language" type="language" label="JFIELD_LANGUAGE_LABEL">
		 <option value="*">JALL_LANGUAGE</option>
	 </field>
	 <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" />
 </fieldset>


</form>

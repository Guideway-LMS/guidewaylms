<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="4.0" method="upgrade">
	<name>GPTranslate</name>
	<author>J!Extensions Store</author>
	<creationDate>2024-11-24</creationDate>
	<copyright>Copyright (C) 2015 - Joomla! Extensions Store. All Rights Reserved.</copyright>
	<license>https://www.gnu.org/licenses/gpl-2.0.html GNU/GPL</license>
	<authorEmail>info@storejextensions.org</authorEmail>
	<authorUrl>http://storejextensions.org</authorUrl>
	<version>2.6</version>
	<description>COM_GPTRANSLATE_INSTALLATION_MESSAGES</description>
	<namespace>JExtstore\Component\Gptranslate</namespace>
	
	<scriptfile>installscript.php</scriptfile>
	
	<install> <!-- Runs on install -->
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install> 
	<uninstall> <!-- Runs on uninstall -->
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	
	<media folder="media" destination="mod_gptranslate">
        <folder>js</folder>
        <folder>flags</folder>
    </media>
    
	<!-- BACKEND -->
	<administration>
		<menu link="option=com_gptranslate" img="class:gptranslate-16x16">GPTRANSLATE</menu>
		<files folder="admin">
			<filename>config.xml</filename>
			<filename>access.xml</filename>
			<filename>index.html</filename>
			<!-- DISPATCHER -->
			<folder>Dispatcher</folder>
			<!-- SERVICES -->
			<folder>services</folder>
			<!-- CONTROLLERS -->
			<folder>Controller</folder> 
			<!-- CSS -->
			<folder>css</folder> 
			<!-- FRAMEWORK -->
			<folder>Framework</folder> 
			<!-- IMAGES -->
			<folder>images</folder>  
			<!-- JS -->
			<folder>js</folder>
			<!-- LANGUAGE -->
			<folder>language</folder>
			<!-- MODEL -->
			<folder>Model</folder>
			<!-- SQL files section -->
			<folder>sql</folder> 
			<!-- TABLES -->
			<folder>Table</folder>
			<!-- VIEWS -->
			<folder>View</folder> 
			<folder>tmpl</folder>
			<!-- LAYOUTS -->
			<folder>layouts</folder> 
		</files>  
	</administration>
	
	<!-- CHANGELOG -->
	<changelogurl>http://storejextensions.org/changelogs/gptranslate.xml</changelogurl>
	
	<!-- UPDATE SERVERS -->
	<updateservers>
		<server type="extension" priority="1" name="GPTranslate Update Server">http://storejextensions.org/updates/gptranslate_updater.xml</server>
	</updateservers>
</extension>